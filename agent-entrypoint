#!/bin/sh
# Starts as root, closes the owner's state to the guest uid, then runs the bot as `agent`.
# Guest turns (people who are not the owner) run as `guest`: the bot may switch to that uid and
# nothing else, and `guest` cannot read /app/run (except run/guest), the bot's environment or mcp-config.json.
set -eu
# /home/agent is agent-writable and sits on PATH in the image, so root must not resolve commands through it.
# The bot gets the original PATH back in the last line.
BOT_PATH=$PATH
PATH=/usr/sbin:/usr/bin:/sbin:/bin
RUN=/app/run

# With no command, `env` below would print the whole environment, tokens included, to the log.
# `env` takes leading NAME=value words as assignments, so a command made only of those leaks the same way.
# The messages never echo an argument: an assignment can carry a token.
if [ "$#" -eq 0 ]; then
  echo "agent-entrypoint: no command given, refusing to start." >&2
  exit 1
fi
has_program=
for a; do
  case $a in *=*) ;; *) has_program=1; break ;; esac
done
if [ -z "$has_program" ]; then
  echo "agent-entrypoint: the command has only assignments and no program, refusing to start." >&2
  exit 1
fi

if [ "$(id -u)" != 0 ]; then
  echo "agent-entrypoint: not started as root, so guest turns cannot get their own uid and share the bot's." >&2
  PATH=$BOT_PATH
  exec "$@"
fi

AG=$(id -g agent)
G=$RUN/guest
# A 1.x guest could plant a symlink or a file where a directory belongs, and root would follow it
# in the chown and chmod below. Replace anything that is not a real directory before touching it.
for d in "$G" "$G/outbox" "$G/telegram" "$G/config" "$G/work" "$G/mcp" "$G/sched"; do
  if [ -L "$d" ] || { [ -e "$d" ] && [ ! -d "$d" ]; }; then
    echo "agent-entrypoint: $d is not a directory, replacing it." >&2
    rm -f "$d" || { echo "agent-entrypoint: cannot remove $d, refusing to start." >&2; exit 1; }
  fi
done
mkdir -p "$G/outbox" "$G/telegram" "$G/config" "$G/work" "$G/mcp" "$G/sched"
# The bot rewrites run/guest/mcp on every turn, and a 1.x guest could have left links there that the
# bot would write through. Empty it on every start (find -delete never follows a symlink).
find "$G/mcp" -mindepth 1 -delete ||
  { echo "agent-entrypoint: cannot empty $G/mcp, refusing to start." >&2; exit 1; }
# The bot writes attachments under run/guest/telegram and follows what it finds there. A 1.x guest could
# have planted a symlink, a hardlink or a FIFO (at a chat dir or a future message id). Drop every entry
# that is neither a regular file nor a directory, every multiply linked non-directory, and any
# non-directory chat entry, before the chown below.
find "$G/telegram" -mindepth 1 \( -type l -o \( ! -type d ! -type f \) -o \( ! -type d -links +1 \) \) -delete &&
  find "$G/telegram" -mindepth 1 -maxdepth 1 ! -type d -delete ||
  { echo "agent-entrypoint: cannot clean $G/telegram, refusing to start." >&2; exit 1; }
# A 1.x guest could also hardlink an owner file into its own area: the chown -R to guest below
# would then hand the owner's inode to guest. Drop any such file with a second link before that.
# A 1.x guest could not create a guest-owned inode, so links a 2.x guest made between its own files stay.
drop_hardlinks() {
  find "$@" ! -type d -links +1 ! -user guest -exec sh -c 'for f; do echo "agent-entrypoint: removing hardlinked $f" >&2; rm -f "$f" || exit 1; done' sh {} + ||
    { echo "agent-entrypoint: cannot remove hardlinks under $*, refusing to start." >&2; exit 1; }
}
# Before the guest uid, guest state sat in run/claude-guest. A symlinked one could point at the
# owner's state, so it is removed without copying. A real one replaces guest/config by a rename:
# 1.x had no guest/config, so anything there was planted, and a copy would write through its links.
if [ -L "$RUN/claude-guest" ]; then
  echo "agent-entrypoint: $RUN/claude-guest is a symlink, removing it without copying." >&2
  rm -f "$RUN/claude-guest"
elif [ -d "$RUN/claude-guest" ]; then
  rm -rf "$G/config" && mv "$RUN/claude-guest" "$G/config" ||
    { echo "agent-entrypoint: cannot move $RUN/claude-guest to $G/config, refusing to start." >&2; exit 1; }
fi
drop_hardlinks "$G/config" "$G/work"

# Owner state: everything in run/ but guest/ (names with two leading dots included) belongs to agent and is closed to everyone else.
# A symlink at the top of run/ is removed: the bot writes its state files there, and a planted link would redirect them.
# chown and chmod also change the inode behind a file with a second link, which a 1.x guest could have
# pointed at a file outside the owner tree. Break such a link first: the file keeps its content in a fresh inode.
# The copy goes to a name mktemp creates exclusively, so a name the guest planted cannot redirect it.
# A failure here refuses to start, because run/ goes to 711 below and an open entry would stay reachable.
break_links() {
  find "$1" ! -type d -links +1 -exec sh -c '
    for f; do
      echo "agent-entrypoint: breaking the extra link of $f" >&2
      if [ -f "$f" ] && [ ! -L "$f" ]; then
        t=$(mktemp -- "$f.XXXXXX") || exit 1
        cp -p -- "$f" "$t" && mv -f -- "$t" "$f" || { rm -f -- "$t"; exit 1; }
      else
        rm -f -- "$f" || exit 1
      fi
    done' sh {} +
}
for p in "$RUN"/* "$RUN"/.[!.]* "$RUN"/..?*; do
  [ -e "$p" ] || [ -L "$p" ] || continue
  [ "$p" = "$G" ] && continue
  if [ -L "$p" ]; then
    echo "agent-entrypoint: removing symlink $p" >&2
    rm -f -- "$p"
  else
    break_links "$p" && chown -hR "agent:$AG" "$p" && chmod -R go-rwx "$p"
  fi || { echo "agent-entrypoint: could not close $p, refusing to start." >&2; exit 1; }
done
chown -h "agent:$AG" "$RUN" "$G"
chmod 711 "$RUN" "$G"

# Guest area. The bot writes outbox, telegram and mcp (guest reads them); the guest writes the rest.
chown -h "agent:$AG" "$G/outbox" "$G/telegram" "$G/mcp" "$G/sched"
chmod 777 "$G/outbox" "$G/sched"
chmod 755 "$G/telegram" "$G/mcp"
# A 1.x guest could leave a chat dir open to others, where a guest turn would plant a link after the
# cleanup above. That cleanup removed every symlink and hardlink, so the recursive chown and chmod are safe.
chown -hR "agent:$AG" "$G/telegram" && chmod -R go-w "$G/telegram" ||
  { echo "agent-entrypoint: cannot close $G/telegram, refusing to start." >&2; exit 1; }
chown -R guest:guest "$G/config" "$G/work"
chmod 700 "$G/config"
# The bot is in the group so it can read and clean up what a guest turn leaves here. Guest turns enter the dir after setpriv, so a chmod 700 by the guest does not lock them out.
chgrp "$AG" "$G/work"
chmod 770 "$G/work"
[ -e /app/.env ] && chown "agent:$AG" /app/.env && chmod 600 /app/.env

# mcp-config.json is a read-only mount: its mode is the host's to set.
if [ -e /app/mcp-config.json ] && setpriv --reuid guest --regid guest --clear-groups test -r /app/mcp-config.json; then
  echo "agent-entrypoint: mcp-config.json is readable by guest turns; chmod 600 it and make it owned by uid 1000 on the host." >&2
fi

# The bot keeps the right to switch to the guest uid (setuid, setgid) and to stop its turns (kill).
CAPS=+setuid,+setgid,+kill
# The image ends as root, so HOME is /root: give the bot (and owner turns) agent's home back.
export HOME=/home/agent USER=agent LOGNAME=agent
export AGENT_GUEST_UID=$(id -u guest) AGENT_GUEST_GID=$(id -g guest) AGENT_GUEST_HOME=/home/guest
exec setpriv --reuid agent --regid "$AG" --init-groups --inh-caps=$CAPS --ambient-caps=$CAPS --no-new-privs env "PATH=$BOT_PATH" "$@"
