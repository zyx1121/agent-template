# ---- Required ----
# From @BotFather (/newbot). For groups, also /setprivacy -> Disable, or @mentions never arrive.
TELEGRAM_BOT_TOKEN=
# Your Telegram user id (@userinfobot): always served, everyone else ignored.
OWNER_USER_ID=
# From `claude setup-token` on a machine with a browser (about 1 year, uses your Claude plan).
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Optional ----
# Group chat ids (negative), comma-separated. In a group only @mentions and replies to the bot
# start a turn, and anyone there can drive the agent: only add groups you trust.
ALLOWED_GROUP_IDS=
AGENT_NAME=Agent
# Claude Code model alias or id; empty uses Claude Code's default.
AGENT_MODEL=
# low, medium, high, xhigh or max; empty uses Claude Code's default.
AGENT_EFFORT=
# Seconds before a turn is stopped.
AGENT_TURN_TIMEOUT=1800

# ---- Telemetry (optional) ----
# OTLP/HTTP JSON with a bearer token, e.g. sensorium. Spans agent.turn, event logs.
SENSORIUM_URL=
SENSORIUM_TOKEN=
OTEL_SERVICE_NAME=
